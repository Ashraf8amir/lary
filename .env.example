# ======================
# Application
# ======================
PORT=3000
APP_NAME=Lary

# ======================
# Database
# ======================
DATABASE_URI=mongodb+srv://username:password@cluster0.mongodb.net/appname
DATABASE_RETRY_ATTEMPTS=5
DATABASE_RETRY_DELAY=3000
DATABASE_MAX_POOL_SIZE=10
DATABASE_MIN_POOL_SIZE=5
DATABASE_SERVER_SELECTION_TIMEOUT_MS=10000

# ======================
# Slack
# ======================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX


# ==========================================
# JWT CONFIGURATION
# ==========================================
JWT_ACCESS_SECRET=your_access_token_secret
JWT_ACCESS_EXPIRATION=15m

JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRATION=7d

# ==========================================
# Redis
# ==========================================
REDIS_HOST=redis host
REDIS_PORT=15689
REDIS_PASSWORD=password redis
REDIS_USERNAME=default
DATABASE_REDIS_DB=0

# ==========================================
# Salla Integration
# ==========================================
SALLA_CLIENT_ID=your_salla_client_id
SALLA_CLIENT_SECRET=your_salla_client_secret
SALLA_BASE_URL=https://api.salla.dev/admin/v2
SALLA_OAUTH_URL=https://accounts.salla.sa
SALLA_TOKEN_REFRESH_WINDOW=86400
SALLA_ENCRYPTION_KEY=your_64_char_hex_key_for_aes256gcm_encryption
SALLA_WEBHOOK_SECRET=your_32_char_hex_iv_for_aes256gcm_encryption
SALLA_APP_ID=your_salla_app_id
SALLA_EMBEDDED_API_URL=https://api.salla.dev
