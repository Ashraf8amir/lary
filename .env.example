# ======================
# Application
# ======================
PORT=3000
APP_NAME=Lary
NODE_ENV=development

# ======================
# Database
# ======================
DATABASE_URI= Your_MongoDB_URI
DATABASE_RETRY_ATTEMPTS= Your_Database_Retry_Attempts
DATABASE_RETRY_DELAY= Your_Database_Retry_Delay
DATABASE_MAX_POOL_SIZE= Your_Database_Max_Pool_Size
DATABASE_MIN_POOL_SIZE= Your_Database_Min_Pool_Size
DATABASE_SERVER_SELECTION_TIMEOUT_MS= Your_Database_Server_Selection_Timeout_MS

# ======================
# Slack
# ======================
SLACK_WEBHOOK_URL= Your_Slack_Webhook_URL

# ==========================================
# JWT CONFIGURATION
# ==========================================
JWT_ACCESS_SECRET=your_access_token_secret
JWT_ACCESS_EXPIRATION= Your_Access_Token_Expiration

JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRATION= Your_Refresh_Token_Expiration

# ==========================================
# Redis
# ==========================================
REDIS_HOST= Your_Redis_Host
REDIS_PORT= Your_Redis_Port
REDIS_PASSWORD= Your_Redis_Password
REDIS_DB=0

# ==========================================
# Salla Integration
# ==========================================
SALLA_CLIENT_ID= Your_Salla_Client_ID
SALLA_CLIENT_SECRET= Your_Salla_Client_Secret
SALLA_BASE_URL=https://api.salla.dev/admin/v2
SALLA_OAUTH_URL=https://accounts.salla.sa
SALLA_TOKEN_REFRESH_WINDOW=86400
SALLA_ENCRYPTION_KEY= Your_32_char_hex_key_for_aes256gcm_encryption
SALLA_WEBHOOK_SECRET= Your_Salla_Webhook_Secret
SALLA_APP_ID= Your_Salla_App_ID
SALLA_EMBEDDED_API_URL=https://api.salla.dev

# ==========================================
# RabbitMQ
# ==========================================
RABBITMQ_URI= Your_RabbitMQ_URI

# ==========================================
# Chatbot Configuration
# ==========================================
GEMINI_API_KEY= Your_Gemini_API_Key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite
CHAT_SESSION_TTL_SECONDS=1800

# ==========================================
# Meilisearch Configuration
# ==========================================
MEILI_HOST= Your_Meilisearch_Host
MEILI_MASTER_KEY= Your_Meilisearch_Master_Key
